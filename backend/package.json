{
  "name": "backend",
  "version": "1.0.0",
  "description": "Campus Events REST API",
  "main": "dist/server.js",
  "scripts": {
    "clean": "node -e \"const fs = require('fs'); if (fs.existsSync('dist')) fs.rmSync('dist', { recursive: true, force: true });\"",
    "dev": "tsx watch src/server.ts",
    "build": "npm run clean && tsc",
    "start": "node dist/server.js",
    "test": "jest",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}
